{
  "name": "maplibre-mcp",
  "version": "0.2.0",
  "description": "An MCP server that lets AI agents check, render and show MapLibre styles",
  "license": "MIT",
  "author": "Birk Skyum (https://github.com/birkskyum)",
  "homepage": "https://birkskyum.github.io/maplibre-mcp/",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birkskyum/maplibre-mcp.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "maplibre",
    "maplibre-gl",
    "maplibre-native",
    "martin",
    "map",
    "maps",
    "style",
    "gis",
    "ai",
    "agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "maplibre-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node build.ts",
    "build:site": "npm run build && node site/generate-tools.ts && node site/generate-changelog.ts && cd site && astro build",
    "dev:site": "npm run build && node site/generate-tools.ts && node site/generate-changelog.ts && cd site && astro dev",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "maplibre-gl": "^6.11.2",
    "pbf": "^5.1.2",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pmtiles": "^4.5.0",
    "pngjs": "^7.0.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@maplibre/maplibre-gl-native": "^6.4.1 || ^6.5.0-pre.1"
  },
  "peerDependenciesMeta": {
    "@maplibre/maplibre-gl-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/starlight": "^0.42.4",
    "@maplibre/geojson-vt": "^6.1.1",
    "@maplibre/maplibre-gl-native": "^6.5.0-pre.1",
    "@maplibre/mlt": "^1.3.0",
    "@maplibre/vt-pbf": "^4.3.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "astro": "^7.3.5",
    "esbuild": "^0.28.2",
    "starlight-llms-txt": "^0.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
