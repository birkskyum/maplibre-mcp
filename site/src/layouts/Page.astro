---
import '../styles/global.css';
import {sitePath} from '../paths';
import {NAVIGATION} from '../project';

type Props = {
    title: string;
    description: string;
};

const {title, description} = Astro.props;
const socialImage = new URL(sitePath('images/social.png'), Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);

const NAV_LINK = 'text-slate-600 hover:text-brand dark:text-slate-300';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical.href}>
<link rel="sitemap" type="application/xml" href={sitePath('sitemap-index.xml')}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="maplibre-mcp">
<meta property="og:url" content={canonical.href}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={socialImage.href}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href={sitePath('favicon.svg')} type="image/svg+xml">
<slot name="head" />
</head>
<body class="bg-white text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">

<header class="sticky top-0 z-10 h-14 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
  <div class="mx-auto flex h-full max-w-7xl items-center justify-between gap-4 px-6">
    <a href={sitePath('')} class="font-mono text-sm font-semibold">maplibre-mcp</a>
    <nav class="flex items-center gap-4 text-sm sm:gap-6">
      {NAVIGATION.map(item => <a href={sitePath(item.path)} class={NAV_LINK}>{item.title}</a>)}
      <a href="https://github.com/birkskyum/maplibre-mcp" aria-label="maplibre-mcp on GitHub" class={NAV_LINK}>
        <svg viewBox="0 0 16 16" class="size-5" fill="currentColor" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
      </a>
    </nav>
  </div>
</header>

<slot />

<footer class="border-t border-slate-200 py-8 text-sm text-slate-500 dark:border-slate-800">
  <div class="mx-auto flex max-w-7xl flex-wrap justify-between gap-2 px-6">
    <span>Made by <a href="https://github.com/birkskyum" class="text-slate-700 hover:text-brand dark:text-slate-300">Birk Skyum</a> · <a href="https://github.com/birkskyum/maplibre-mcp" class="hover:text-brand">Source on GitHub</a> · <a href={sitePath('llms.txt')} class="hover:text-brand">llms.txt</a></span>
    <span>Built on MapLibre GL JS, MapLibre Native, Martin and OpenFreeMap</span>
  </div>
  <p class="mx-auto mt-2 max-w-7xl px-6">© 2026 Birk Skyum · MIT license</p>
</footer>

</body>
</html>
