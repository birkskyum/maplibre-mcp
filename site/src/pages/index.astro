---
import SessionItem from '../components/SessionItem.astro';
import session from '../data/session.json';
import {sitePath} from '../docs';
import Page from '../layouts/Page.astro';

const CHECK_TOOLS = ['validate_style', 'describe_style_spec', 'describe_sources', 'format_style', 'migrate_style'];
const SEE_TOOLS = ['render_style', 'compare_styles', 'compare_renderers'];
const SHOW_TOOLS = ['show_map'];

/** One-line setups for the clients whose command line adds MCP servers. */
const INSTALL_COMMANDS = [
    {client: 'Claude Code', command: 'claude mcp add maplibre -- npx -y maplibre-mcp'},
    {client: 'Codex', command: 'codex mcp add maplibre -- npx -y maplibre-mcp'},
    {client: 'Gemini CLI', command: 'gemini mcp add maplibre npx -- -y maplibre-mcp'},
    {client: 'Grok', command: 'grok mcp add maplibre -- npx -y maplibre-mcp'},
    {client: 'VS Code', command: `code --add-mcp '{"name": "maplibre", "command": "npx", "args": ["-y", "maplibre-mcp"]}'`},
];
const SERVER_CONFIG = {command: 'npx', args: ['-y', 'maplibre-mcp']};
const CURSOR_LINK = `cursor://anysphere.cursor-deeplink/mcp/install?name=maplibre&config=${btoa(JSON.stringify(SERVER_CONFIG))}`;
const CLIENT_JSON = `{
  "mcpServers": {
    "maplibre": {
      "command": "npx",
      "args": ["-y", "maplibre-mcp"]
    }
  }
}`;
const TABS = [...INSTALL_COMMANDS.map(install => install.client), 'Cursor', 'Other'];

const BUTTON = 'rounded-full px-5 py-2.5 text-sm font-semibold';
const CONTROL = 'rounded-full border border-slate-300 px-4 py-1.5 text-sm font-semibold hover:border-brand hover:text-brand dark:border-slate-600 dark:hover:border-sky-400 dark:hover:text-sky-400';
const SECTION_TITLE = 'text-3xl font-bold tracking-tight';
const SECTION_LEAD = 'mt-4 text-lg text-slate-600 dark:text-slate-300';
const TOOL_LIST = 'mt-3 font-mono text-xs text-slate-500 dark:text-slate-400';
const OUTPUT_CARD = 'rounded-lg bg-slate-900 p-4 text-slate-100 dark:bg-slate-800';
const TAB = 'shrink-0 rounded-t-lg px-3 py-1.5 text-sm font-medium';
const SELECTED_TAB = 'bg-slate-900 text-white dark:bg-slate-800';
const OTHER_TAB = 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white';
const PANEL = 'items-baseline gap-3 px-4 py-3';
const COPY_BUTTON = 'shrink-0 rounded bg-slate-700 px-3 py-1 font-sans text-xs text-slate-100 hover:bg-slate-600';
---
<Page title="maplibre-mcp · MCP server for MapLibre" description="An MCP server that lets AI agents check, render and show MapLibre styles.">
<link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/maplibre-gl@6.11.2/dist/maplibre-gl.css">

<main>
  <section class="mx-auto max-w-7xl px-6 pt-16 pb-20 text-center">
    <p class="text-sm font-semibold text-brand dark:text-sky-400">MCP server for MapLibre</p>
    <h1 class="mx-auto mt-3 max-w-4xl text-4xl font-bold tracking-tight sm:text-6xl">Let AI agents check, render and show MapLibre styles</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
      maplibre-mcp helps AI agents get MapLibre styles right. With it, an agent can check a style, look at the map it made, and show you an interactive map.
      It runs on your computer and needs no API key.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={sitePath('getting-started/')} class={`${BUTTON} bg-brand text-white hover:bg-brand/90`}>Get started</a>
      <a href="#demo" class={`${BUTTON} bg-slate-100 text-slate-900 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700`}>See how it works</a>
    </div>
    <div data-tabs class="mx-auto mt-10 max-w-2xl text-left">
      <div role="tablist" aria-label="Your AI client" class="flex gap-1 overflow-x-auto max-sm:[mask-image:linear-gradient(to_right,black_85%,transparent)]">
        {TABS.map((tab, index) => (
          <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} class={`${TAB} ${index === 0 ? SELECTED_TAB : OTHER_TAB}`}>{tab}</button>
        ))}
      </div>
      <div class="rounded-lg rounded-tl-none bg-slate-900 font-mono text-sm text-slate-100 dark:bg-slate-800">
        {INSTALL_COMMANDS.map((install, index) => (
          <div role="tabpanel" hidden={index > 0} class={`flex ${PANEL}`}>
            <span class="select-none text-slate-500">$</span>
            <code id={`install-${index}`} class="min-w-0 flex-1 break-words">{install.command}</code>
            <button type="button" data-copy={`install-${index}`} class={COPY_BUTTON}>Copy</button>
          </div>
        ))}
        <div role="tabpanel" hidden class={`flex flex-wrap justify-between ${PANEL} font-sans`}>
          <span class="text-slate-300">Cursor adds it from a link, after you confirm.</span>
          <a href={CURSOR_LINK} class={COPY_BUTTON}>Add to Cursor</a>
        </div>
        <div role="tabpanel" hidden class="px-4 py-3">
          <div class="flex items-baseline justify-between gap-3 font-sans">
            <span class="text-slate-300">Claude Desktop, Windsurf and most other clients read this JSON.</span>
            <button type="button" data-copy="install-json" class={COPY_BUTTON}>Copy</button>
          </div>
          <pre id="install-json" class="mt-3 overflow-x-auto">{CLIENT_JSON}</pre>
        </div>
      </div>
    </div>
    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
      Needs Node.js 22 or newer. <a href={sitePath('getting-started/')} class="underline hover:text-brand">Where each client keeps its settings</a>
    </p>
  </section>

  <section id="demo" class="scroll-mt-14 border-t border-slate-200 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-6 py-20">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class={SECTION_TITLE}>How it works</h2>
      <p class={SECTION_LEAD}>
        Coding agents like Claude Code, Codex and Cursor can edit a MapLibre style, but they can't see the map, and they can mix up MapLibre and Mapbox.
        MCP, the Model Context Protocol, lets an agent call tools, and maplibre-mcp gives it tools to check styles and look at maps.
        This is a real session, step by step.
      </p>
    </div>
    <div data-walkthrough class="mt-12 grid gap-8 lg:grid-cols-[22rem_1fr]">
      <ol class="hidden space-y-1 lg:block">
        {session.steps.map((step, index) => (
          <li>
            <button type="button" data-go={index} class="flex w-full items-start gap-3 rounded-xl px-3 py-2.5 text-left hover:bg-slate-50 dark:hover:bg-slate-900">
              <span data-number class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full border text-xs font-semibold">{index + 1}</span>
              <span>
                <span class="block font-medium">{step.title}</span>
                <span data-caption class="mt-1 hidden text-sm text-slate-600 dark:text-slate-300">{step.caption}</span>
              </span>
            </button>
          </li>
        ))}
      </ol>
      <div class="min-w-0">
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-950">
          <div class="h-1 bg-slate-100 dark:bg-slate-800"><div data-progress class="h-full w-0 bg-brand dark:bg-sky-400"></div></div>
          <div class="grid grid-cols-1 p-4 sm:p-6">
            {session.steps.map((step, index) => (
              <div data-step class:list={['col-start-1 row-start-1 space-y-3 self-center transition-opacity duration-300', index > 0 && 'invisible opacity-0']}>
                <div class="mb-4 lg:hidden">
                  <p class="text-xs font-semibold text-brand dark:text-sky-400">Step {index + 1} of {session.steps.length}</p>
                  <h3 class="mt-1 font-semibold">{step.title}</h3>
                  <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{step.caption}</p>
                </div>
                {step.items.map(item => <SessionItem {...item} />)}
              </div>
            ))}
          </div>
        </div>
        <div class="mt-4 flex justify-center gap-2 lg:justify-end">
          <button type="button" data-previous class={CONTROL}>Back</button>
          <button type="button" data-play class={CONTROL}>Play</button>
          <button type="button" data-next class={CONTROL}>Next</button>
        </div>
      </div>
    </div>
    </div>
  </section>

  <section class="border-t border-slate-200 py-20 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class={SECTION_TITLE}>What it does</h2>
        <p class={SECTION_LEAD}>The agent gets tools for three jobs, and decides by itself when to use them.</p>
      </div>
      <div class="mt-12 grid gap-16">
        <div class="grid gap-6 md:grid-cols-5 md:gap-10">
          <div class="md:col-span-2">
            <h3 class="text-xl font-semibold">Check</h3>
            <p class="mt-2 text-slate-600 dark:text-slate-300">
              Validate a style against the MapLibre Style Specification, look up any property or expression with the GL JS and Native versions that support it,
              and find layers that use a source layer or field the data does not have.
            </p>
            <p class={TOOL_LIST}>{CHECK_TOOLS.map((tool, index) => <>{index > 0 && ' · '}<a href={sitePath(`tools/#${tool}`)} class="hover:text-brand">{tool}</a></>)}</p>
          </div>
          <div class="space-y-3 font-mono text-xs md:col-span-3">
            <div class={OUTPUT_CARD}>
              <p class="text-sky-300">validate_style</p>
              <p class="mt-1">error: layers[0].paint.line-colour: unknown property "line-colour"</p>
            </div>
            <div class={OUTPUT_CARD}>
              <p class="text-sky-300">describe_style_spec {`{"name": "fill-colour"}`}</p>
              <p class="mt-1">"fill-colour" is not in the MapLibre Style Specification. Did you mean: fill-color?</p>
            </div>
            <div class={OUTPUT_CARD}>
              <p class="text-sky-300">describe_sources</p>
              <p class="mt-1">Layer "motorways" reads the field "kind", which "omt" does not list for "transportation".</p>
            </div>
          </div>
        </div>

        <div class="grid gap-6 md:grid-cols-5 md:gap-10">
          <div class="md:col-span-2">
            <h3 class="text-xl font-semibold">See</h3>
            <p class="mt-2 text-slate-600 dark:text-slate-300">
              Render a style with MapLibre GL JS, MapLibre Native or a Martin server, and compare two versions of a style, or two renderers, with the differences in red.
            </p>
            <p class={TOOL_LIST}>{SEE_TOOLS.map((tool, index) => <>{index > 0 && ' · '}<a href={sitePath(`tools/#${tool}`)} class="hover:text-brand">{tool}</a></>)}</p>
          </div>
          <figure class="md:col-span-3">
            <img src={sitePath('images/compare-renderers.webp')} width="1276" height="300" loading="lazy" class="w-full rounded-lg border border-slate-200 dark:border-slate-700"
                 alt="Copenhagen in 3D, drawn by MapLibre GL JS and by MapLibre Native, with a third panel marking the few pixels that differ">
            <figcaption class="mt-2 text-sm text-slate-500 dark:text-slate-400">compare_renderers: GL JS and Native agree, apart from where a few labels land.</figcaption>
          </figure>
        </div>

        <div class="grid gap-6 md:grid-cols-5 md:gap-10">
          <div class="md:col-span-2">
            <h3 class="text-xl font-semibold">Show</h3>
            <p class="mt-2 text-slate-600 dark:text-slate-300">
              Show you an interactive map with GeoJSON layers and markers, right in the chat, in clients that support MCP Apps.
            </p>
            <p class={TOOL_LIST}>{SHOW_TOOLS.map(tool => <a href={sitePath(`tools/#${tool}`)} class="hover:text-brand">{tool}</a>)}</p>
          </div>
          <figure class="md:col-span-3">
            <div id="live-map" class="h-96 w-full overflow-hidden rounded-lg border border-slate-200 dark:border-slate-700"></div>
            <figcaption class="mt-2 text-sm text-slate-500 dark:text-slate-400">The kind of map show_map puts in the chat. This one is live.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>
</main>

<script>
import '../scripts/landing.js';
</script>
</Page>
